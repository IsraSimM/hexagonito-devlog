---
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import { langs, t, url, type Lang } from "../../../i18n/ui";
import { getFactions, getUnits } from "../../../data/factions";

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const factions = await Promise.all(
  (await getFactions()).map(async (f) => ({ f, count: (await getUnits(f.id)).length })),
);
---

<Base lang={lang} title={t(lang, "factions.title")} description={t(lang, "factions.lead")} path="factions/">
  <section class="container head">
    <p class="kicker">HexaGonito</p>
    <h1>{t(lang, "factions.title")}</h1>
    <p class="muted">{t(lang, "factions.lead")}</p>
  </section>
  <section class="container list">
    {factions.map(({ f, count }) => (
      <a class:list={["faction", f.data.cardStyle]} href={url(`${lang}/factions/${f.data.path}/`)} style={`--fa:${f.data.accent};--fb:${f.data.accent2}`}>
        <Image src={f.data.sheet} alt={f.data[lang].name} widths={[600, 1000, 1536]} sizes="(max-width: 1120px) 100vw, 1060px" />
        <div class="txt">
          <p class="motto">{f.data[lang].motto}</p>
          <h2>{f.data[lang].name}</h2>
          <p>{f.data[lang].lead}</p>
          <span class="go">{count} {t(lang, "factions.units").toLowerCase()} →</span>
        </div>
      </a>
    ))}
  </section>
</Base>

<style>
  .head { padding-top: 3rem; margin-bottom: 2rem; }
  .list { display: grid; gap: 1.5rem; }
  .faction {
    display: grid; grid-template-columns: 1.4fr 1fr; text-decoration: none; color: var(--text);
    border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface);
    border-left: 5px solid var(--fa); transition: transform 0.18s, box-shadow 0.18s;
  }
  .faction:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .faction img { width: 100%; height: 100%; object-fit: cover; }
  .txt {
    padding: 2rem; display: flex; flex-direction: column; justify-content: center;
    background: radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--fa) 22%, transparent), transparent 70%);
  }
  .motto { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.8rem; color: var(--fa); margin: 0 0 0.4rem; }
  h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .txt p:not(.motto) { color: var(--muted); }
  .go { font-family: var(--font-display); font-weight: 700; color: var(--fa); }
  .rugged h2 { color: var(--fa); text-shadow: 3px 3px 0 color-mix(in srgb, var(--fb) 70%, transparent); }
  @media (max-width: 800px) { .faction { grid-template-columns: 1fr; } }
</style>
