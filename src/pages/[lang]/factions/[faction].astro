---
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import UnitCard from "../../../components/UnitCard.astro";
import { langs, t, url, type Lang } from "../../../i18n/ui";
import { getFactions, getRoles, getUnits, type FactionEntry } from "../../../data/factions";

export async function getStaticPaths() {
  const factions = await getFactions();
  return langs.flatMap((lang) =>
    factions.map((f) => ({ params: { lang, faction: f.data.path }, props: { faction: f, factions } })),
  );
}

const lang = Astro.params.lang as Lang;
const { faction, factions } = Astro.props as { faction: FactionEntry; factions: FactionEntry[] };
const f = faction.data;
const units = await getUnits(faction.id);
const roles = await getRoles();
const others = factions.filter((x) => x.id !== faction.id);
---

<Base lang={lang} title={f[lang].name} description={f[lang].lead} path={`factions/${f.path}/`}>
  <div class:list={["faction", f.cardStyle]} style={`--fa:${f.accent};--fb:${f.accent2}`}>
    <section class="hero">
      <div class="container">
        <a class="back" href={url(`${lang}/factions/`)}>← {t(lang, "factions.title")}</a>
        <p class="motto">{f[lang].motto}</p>
        <h1>{f[lang].name}</h1>
        <p class="lead">{f[lang].lead}</p>
        <nav class="roster" aria-label={t(lang, "factions.units")}>
          {units.map((u) => {
            const r = roles[u.data.role.id];
            return (
              <a href={`#${u.data.role.id}`} style={`--r:${r.color}`} title={u.data[lang].name}>
                <Image src={u.data.portrait} alt="" width={96} />
                <span>{r.label[lang]}</span>
              </a>
            );
          })}
        </nav>
      </div>
    </section>

    <section class="container units">
      {units.map((u, i) => (
        <UnitCard unit={u} role={roles[u.data.role.id]} lang={lang} index={i + 1} total={units.length} />
      ))}
    </section>

    <section class="container next">
      {others.map((o) => (
        <a class="btn" href={url(`${lang}/factions/${o.data.path}/`)} style={`--fa:${o.data.accent}`}>
          {t(lang, "factions.see")}: {o.data[lang].name} →
        </a>
      ))}
    </section>
  </div>
</Base>

<style>
  .hero {
    padding: 2.5rem 0 3rem;
    background:
      radial-gradient(ellipse at 15% 0%, color-mix(in srgb, var(--fa) 28%, transparent), transparent 60%),
      radial-gradient(ellipse at 90% 100%, color-mix(in srgb, var(--fb) 22%, transparent), transparent 60%);
    border-bottom: 1px solid color-mix(in srgb, var(--fa) 40%, var(--line));
  }
  .back { font-family: var(--font-display); font-weight: 700; text-decoration: none; color: var(--fa); }
  .motto {
    margin: 1.6rem 0 0.3rem; font-family: var(--font-display); font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.22em; font-size: 0.85rem; color: var(--fa);
  }
  h1 { font-size: clamp(2.6rem, 8vw, 5rem); margin-bottom: 0.2em; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 60ch; }
  .roster { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0.5rem; margin-top: 2rem; }
  .roster a {
    display: flex; flex-direction: column; align-items: center; gap: 0.25rem; text-decoration: none;
    padding: 0.4rem 0.2rem; border-radius: 10px; border: 1px solid var(--line); background: var(--surface);
    transition: border-color 0.15s, transform 0.15s;
  }
  .roster a:hover { border-color: var(--r); transform: translateY(-2px); }
  .roster img { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: 50% 30%; border-radius: 6px; }
  .roster span { font-size: 0.65rem; font-weight: 700; color: var(--r); text-transform: uppercase; letter-spacing: 0.04em; text-align: center; }
  .units { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 500px), 1fr)); gap: 1.2rem; margin-top: 3rem; }
  .next { margin-top: 3rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .next .btn:hover { border-color: var(--fa); color: var(--fa); }

  /* Variantes de estilo (cardStyle en la facción) */
  .clean { --face-bg: linear-gradient(180deg, color-mix(in srgb, var(--fb) 7%, var(--surface)), var(--surface)); }
  .clean h1 { background: linear-gradient(90deg, var(--text), var(--fb)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .rugged {
    --card-radius: 4px;
    --card-clip: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 22px 100%, 0 calc(100% - 22px));
    --face-bg: linear-gradient(180deg, color-mix(in srgb, var(--fb) 8%, var(--surface)), var(--surface));
  }
  .rugged h1 { color: var(--fa); text-shadow: 3px 3px 0 color-mix(in srgb, var(--fb) 70%, transparent); letter-spacing: 0.03em; }
  .rugged .motto { color: var(--fb); }

  @media (max-width: 900px) { .roster { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .roster { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
