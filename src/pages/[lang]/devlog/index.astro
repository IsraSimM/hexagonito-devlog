---
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import { getPosts, langs, t, type Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const posts = await getPosts(lang);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base lang={lang} title={t(lang, "devlog.title")} path="devlog/">
  <section class="container head">
    <p class="kicker">HexaGonito</p>
    <h1>{t(lang, "devlog.title")}</h1>
    <p class="muted">{t(lang, "devlog.lead")}</p>
    <div class="filters" role="group" aria-label={t(lang, "devlog.filter")}>
      <button type="button" data-tag="" aria-pressed="true">{t(lang, "devlog.all")}</button>
      {tags.map((tag) => <button type="button" data-tag={tag} aria-pressed="false">#{tag}</button>)}
    </div>
  </section>
  <section class="container grid" id="posts">
    {posts.map((post) => <PostCard post={post} lang={lang} />)}
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filters button");
  const cards = document.querySelectorAll<HTMLElement>("#posts .card");
  function apply(tag: string) {
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tag === tag)));
    cards.forEach((c) => {
      const tags = (c.dataset.tags ?? "").split(",");
      c.hidden = tag !== "" && !tags.includes(tag);
    });
  }
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const tag = b.dataset.tag ?? "";
      apply(tag);
      history.replaceState(null, "", tag ? `#${encodeURIComponent(tag)}` : location.pathname);
    }),
  );
  const initial = decodeURIComponent(location.hash.slice(1));
  if (initial) apply(initial);
</script>

<style>
  .head { padding-top: 3rem; margin-bottom: 2rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.5rem; }
  .filters button {
    font: inherit; font-size: 0.85rem; font-weight: 600; cursor: pointer;
    padding: 0.35em 0.9em; border-radius: 999px;
    border: 1px solid var(--line); background: var(--surface); color: var(--muted);
  }
  .filters button:hover { border-color: var(--gold); color: var(--text); }
  .filters button[aria-pressed="true"] { background: var(--gold); border-color: var(--gold); color: var(--gold-ink); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.2rem; }
  .grid :global(.card[hidden]) { display: none; }
</style>
