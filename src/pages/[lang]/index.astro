---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts, langs, t, url, type Lang } from "../../i18n/ui";
import { stats } from "../../data/game";
import humanos from "../../assets/art/humanos.png";
import orcos from "../../assets/art/orcos.png";

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const posts = await getPosts(lang);
const [latest, ...rest] = posts;
const factions = [
  { img: humanos, name: lang === "es" ? "Humanos" : "Humans", color: "var(--crest)", alt: lang === "es" ? "Concept art de las 12 unidades humanas" : "Concept art of the 12 human units" },
  { img: orcos, name: lang === "es" ? "Orcos" : "Orcs", color: "var(--ork)", alt: lang === "es" ? "Concept art de las 12 unidades orcas" : "Concept art of the 12 orc units" },
];
---

<Base lang={lang}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker">{t(lang, "home.kicker")}</p>
        <h1>{t(lang, "home.title")}</h1>
        <p class="lead">{t(lang, "home.lead")}</p>
        <div class="ctas">
          <a class="btn primary" href={url(`${lang}/devlog/`)}>{t(lang, "home.cta.devlog")} →</a>
          <a class="btn" href={url(`${lang}/game/`)}>{t(lang, "home.cta.game")}</a>
        </div>
      </div>
      <div class="emblem" aria-hidden="true">
        <div class="hexframe"><Logo size="72%" /></div>
      </div>
    </div>
    <div class="container">
      <dl class="stats">
        <div><dt>{t(lang, "stats.tests")}</dt><dd>{stats.tests}</dd></div>
        <div><dt>{t(lang, "stats.units")}</dt><dd>{stats.units}</dd></div>
        <div><dt>{t(lang, "stats.milestones")}</dt><dd>{stats.milestones}</dd></div>
        <div><dt>{t(lang, "stats.engine")}</dt><dd>{stats.engine}</dd></div>
      </dl>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <h2>{t(lang, "home.latest")}</h2>
      <a href={url(`${lang}/devlog/`)}>{t(lang, "home.all")} →</a>
    </div>
    {latest && <PostCard post={latest} lang={lang} featured />}
    <div class="grid">
      {rest.slice(0, 3).map((post) => <PostCard post={post} lang={lang} />)}
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div>
        <h2>{t(lang, "home.factions")}</h2>
        <p class="muted">{t(lang, "home.factions.lead")}</p>
      </div>
    </div>
    <div class="factions">
      {factions.map((f) => (
        <figure style={`--accent:${f.color}`}>
          <Image src={f.img} alt={f.alt} widths={[600, 1000, 1536]} sizes="(max-width: 860px) 100vw, 540px" />
          <figcaption>{f.name}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(2.5rem, 7vw, 5.5rem) 0 2rem; }
  .hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: center; }
  .lead { font-size: 1.2rem; color: var(--muted); max-width: 52ch; }
  .ctas { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.6rem; }
  .emblem { display: grid; place-items: center; }
  .hexframe {
    width: min(100%, 340px); aspect-ratio: 1 / 1.1547; display: grid; place-items: center;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background:
      radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--gold) 30%, transparent), transparent 70%),
      var(--surface);
    --logo-cut: var(--surface);
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float { 50% { transform: translateY(-10px) rotate(-1.5deg); } }
  .stats {
    margin: 3rem 0 0; display: grid; grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); overflow: hidden;
  }
  .stats div { padding: 1.1rem 1.3rem; border-left: 1px solid var(--line); display: flex; flex-direction: column-reverse; }
  .stats div:first-child { border-left: 0; }
  .stats dt { color: var(--muted); font-size: 0.85rem; }
  .stats dd { margin: 0; font-family: var(--font-display); font-size: 1.8rem; font-weight: 700; color: var(--gold); }
  .section { margin-top: 4.5rem; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
  .section-head h2 { margin: 0; }
  .section-head p { margin: 0.3rem 0 0; }
  .section-head a { font-family: var(--font-display); font-weight: 700; white-space: nowrap; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.2rem; margin-top: 1.2rem; }
  .factions { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  figure { margin: 0; position: relative; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  figure img { width: 100%; transition: transform 0.4s; }
  figure:hover img { transform: scale(1.03); }
  figcaption {
    position: absolute; left: 1rem; bottom: 1rem; padding: 0.3em 0.9em; border-radius: 8px;
    background: var(--accent); color: #fff; font-family: var(--font-display); font-weight: 700; letter-spacing: 0.05em;
  }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .emblem { order: -1; }
    .hexframe { width: 180px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats div:nth-child(3) { border-left: 0; }
    .stats div:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .factions { grid-template-columns: 1fr; }
  }
</style>
