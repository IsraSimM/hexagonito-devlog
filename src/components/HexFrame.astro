---
/**
 * Marco hexagonal para arte. La imagen RELLENA el hexágono (object-fit: cover),
 * así que cualquier imagen funciona sin importar su proporción.
 *
 * - orientation: "flat" (lados arriba/abajo, más ancho; ideal para renders 16:9)
 *                "pointy" (vértice arriba, más alto; ideal para retratos)
 * - focus: punto de la imagen que queda al centro, como object-position ("56% 50%").
 *          Muévelo hacia donde está el personaje si al cambiar la imagen queda descentrado.
 * - zoom: >1 acerca (recorta más), 1 = encaje justo.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  orientation?: "flat" | "pointy";
  focus?: string;
  zoom?: number;
  caption?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}

const {
  src, alt, orientation = "flat", focus = "50% 50%", zoom = 1, caption,
  widths = [400, 700, 1000], sizes = "(max-width: 860px) 90vw, 460px", class: cls = "",
} = Astro.props;
---

<figure class:list={["hexframe", orientation, cls]} style={`--focus:${focus};--zoom:${zoom}`}>
  <div class="clip">
    <Image src={src} alt={alt} widths={widths} sizes={sizes} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .hexframe { margin: 0; position: relative; width: 100%; }
  .flat { --shape: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); aspect-ratio: 1.1547 / 1; }
  .pointy { --shape: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); aspect-ratio: 1 / 1.1547; }
  /* borde dorado: el fondo del marco asoma 3px alrededor del recorte interior */
  .hexframe::before {
    content: ""; position: absolute; inset: 0; clip-path: var(--shape);
    background: linear-gradient(160deg, var(--gold), color-mix(in srgb, var(--gold) 40%, var(--bg)));
  }
  .clip { position: absolute; inset: 4px; clip-path: var(--shape); overflow: hidden; background: var(--surface); }
  .clip img {
    width: 100%; height: 100%; object-fit: cover; object-position: var(--focus);
    transform: scale(var(--zoom)); transform-origin: var(--focus);
  }
  figcaption {
    position: absolute; right: 6%; bottom: 4%; background: var(--gold); color: var(--gold-ink);
    font-family: var(--font-display); font-weight: 700; padding: 0.2em 0.8em; border-radius: 8px;
  }
</style>
