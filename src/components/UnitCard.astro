---
/**
 * Carta de unidad con dos caras. Todo el contenido sale de src/content/units/<facción>/<rol>.yaml;
 * este componente solo lo pinta. El tamaño de la carta lo marca el anverso: el reverso se
 * superpone con el mismo tamaño (y desplaza su contenido si no cabe).
 */
import HexFrame from "./HexFrame.astro";
import { t, type Lang } from "../i18n/ui";
import type { RoleEntry, UnitEntry } from "../data/factions";

interface Props {
  unit: UnitEntry;
  role: RoleEntry["data"];
  lang: Lang;
  index: number;
  total: number;
}
const { unit, role, lang, index, total } = Astro.props;
const d = unit.data;
const txt = d[lang];
const id = d.role.id;
const pad = (n: number) => String(n).padStart(2, "0");
const statKeys = ["health", "attack", "defense", "move", "range"] as const;
const flipLabel = t(lang, "factions.flip");
const backLabel = t(lang, "factions.flipBack");
---

<article class="unit-card" id={id} style={`--r:${role.color}`}>
  <div class="inner">
    <div class="face front">
      <HexFrame src={d.portrait} alt={txt.name} orientation="pointy" focus="50% 40%" widths={[240, 400]} sizes="180px" class="portrait" />
      <div class="info">
        <div class="top">
          <span class="role">{role.label[lang]}</span>
          <span class="num">{pad(index)}/{pad(total)}</span>
        </div>
        <h2>{txt.name}</h2>
        <p class="title">{txt.title}</p>
        <p>{txt.summary}</p>
        <h3>{t(lang, "factions.stats")}</h3>
        {d.stats ? (
          <dl class="stats">
            {statKeys.map((k) => <div><dt>{t(lang, `factions.${k}`)}</dt><dd>{d.stats![k]}</dd></div>)}
          </dl>
        ) : (
          <p class="tbd">{t(lang, "factions.tbd")}</p>
        )}
      </div>
      <button type="button" class="flip" data-flip aria-label={flipLabel} title={flipLabel} aria-expanded="false" aria-controls={`${id}-back`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 13.7-5.6M20 4v5h-5M20 12a8 8 0 0 1-13.7 5.6M4 20v-5h5" /></svg>
      </button>
    </div>

    <div class="face back" id={`${id}-back`} inert aria-hidden="true">
      <div class="back-scroll">
        <div class="back-head">
          <span class="role">{role.label[lang]}</span>
          <h2>{txt.name}</h2>
        </div>

        <h3>{t(lang, "factions.passive")}</h3>
        {txt.passive ? (
          <p><strong>{txt.passive.name}.</strong> {txt.passive.text}</p>
        ) : (
          <p class="tbd">{t(lang, "factions.tbd")}</p>
        )}

        <h3>{t(lang, "factions.abilities")}</h3>
        {txt.abilities.length ? (
          <ul class="abilities">
            {txt.abilities.map((a) => (
              <li>
                <strong>{a.name}</strong>
                {a.cooldown != null && <span class="chip">{a.cooldown} {t(lang, "factions.cooldown")}</span>}
                {a.cost && <span class="chip">{t(lang, "factions.cost")}: {a.cost}</span>}
                <p>{a.text}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="tbd">{t(lang, "factions.tbd")}</p>
        )}

        <h3>{t(lang, "factions.story")}</h3>
        {txt.story ? (
          txt.story.trim().split(/\n{2,}/).map((p) => <p class="story">{p}</p>)
        ) : (
          <p class="tbd">{t(lang, "factions.storyTbd")}</p>
        )}
      </div>
      <button type="button" class="flip" data-flip aria-label={backLabel} title={backLabel} aria-controls={`${id}-back`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 13.7-5.6M20 4v5h-5M20 12a8 8 0 0 1-13.7 5.6M4 20v-5h5" /></svg>
      </button>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>(".unit-card [data-flip]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest(".unit-card")!;
      const flipped = card.classList.toggle("flipped");
      const front = card.querySelector<HTMLElement>(".front")!;
      const back = card.querySelector<HTMLElement>(".back")!;
      front.inert = flipped;
      back.inert = !flipped;
      front.setAttribute("aria-hidden", String(flipped));
      back.setAttribute("aria-hidden", String(!flipped));
      front.querySelector("[data-flip]")?.setAttribute("aria-expanded", String(flipped));
      (flipped ? back : front).querySelector<HTMLElement>("[data-flip]")?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .unit-card { perspective: 1600px; scroll-margin-top: 90px; }
  .inner { position: relative; height: 100%; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); transform-style: preserve-3d; }
  .flipped .inner { transform: rotateY(180deg); }
  .face {
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    padding: 1.4rem; background: var(--face-bg, var(--surface)); border: 1px solid var(--line);
    border-radius: var(--card-radius, var(--radius)); border-left: 4px solid var(--r);
    clip-path: var(--card-clip, none);
  }
  /* El anverso define el tamaño; el reverso lo copia */
  .front { position: relative; height: 100%; display: grid; grid-template-columns: 180px 1fr; gap: 1.3rem; align-items: start; }
  .back { position: absolute; inset: 0; transform: rotateY(180deg); display: flex; }
  .back-scroll {
    flex: 1; min-height: 0; overflow-y: auto; padding-right: 2.2rem;
    scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--r) 40%, transparent) transparent;
  }
  .unit-card:target .face { box-shadow: inset 0 0 0 2px var(--r); }
  .front :global(.portrait) { --gold: var(--r); }

  .top { display: flex; justify-content: space-between; align-items: center; padding-right: 2.2rem; }
  .role {
    display: inline-block;
    font-family: var(--font-display); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--r); padding: 0.15em 0.6em; border-radius: 6px; background: color-mix(in srgb, var(--r) 15%, transparent);
  }
  .num { font-family: var(--font-display); color: var(--muted); font-size: 0.85rem; }
  h2 { font-size: 1.6rem; margin: 0.5rem 0 0.1rem; }
  .title { color: var(--fa, var(--gold)); font-weight: 600; margin-bottom: 0.5rem; }
  p { font-size: 0.97rem; }
  h3 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); margin: 1rem 0 0.4rem; }
  .tbd { display: inline-block; font-size: 0.85rem; color: var(--muted); border: 1px dashed var(--line); padding: 0.3em 0.8em; border-radius: 8px; margin: 0; }
  .stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.3rem; margin: 0; }
  .stats div { background: var(--surface-2); border-radius: 8px; padding: 0.35rem; text-align: center; }
  .stats dt { font-size: 0.65rem; color: var(--muted); }
  .stats dd { margin: 0; font-family: var(--font-display); font-weight: 700; color: var(--r); }

  /* Botón mini de volteo, en la esquina */
  .flip {
    position: absolute; top: 1.1rem; right: 1.1rem; width: 30px; height: 30px; padding: 0;
    display: grid; place-items: center; cursor: pointer; border-radius: 50%;
    color: var(--r); background: color-mix(in srgb, var(--r) 12%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--r) 45%, transparent);
    transition: background 0.15s, transform 0.3s;
  }
  .flip:hover { background: color-mix(in srgb, var(--r) 25%, var(--surface)); transform: rotate(180deg); }
  .flip svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .back-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .back h2 { font-size: 1.2rem; margin: 0; }
  .back h3 { margin: 0.7rem 0 0.25rem; }
  .back p { font-size: 0.92rem; margin: 0 0 0.4em; }
  .back p.tbd { font-size: 0.78rem; padding: 0.15em 0.6em; margin: 0; }
  .abilities { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .abilities li { background: var(--surface-2); border-radius: 10px; padding: 0.5rem 0.75rem; border-left: 3px solid var(--r); }
  .abilities p { margin: 0.2rem 0 0; font-size: 0.9rem; }
  .chip { font-size: 0.7rem; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 0 0.5em; margin-left: 0.4rem; white-space: nowrap; }
  .story { font-style: italic; opacity: 0.9; margin-bottom: 0.6em; }

  @media (prefers-reduced-motion: reduce) { .inner { transition: none; } }
  @media (max-width: 560px) {
    .front { grid-template-columns: 1fr; }
    .front :global(.portrait) { max-width: 180px; margin-inline: auto; }
    .stats { grid-template-columns: repeat(3, 1fr); }
  }
</style>
