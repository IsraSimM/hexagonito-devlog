---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate, postSlug, readingTime, t, url, type Lang } from "../i18n/ui";

interface Props { post: CollectionEntry<"devlog">; lang: Lang; featured?: boolean }
const { post, lang, featured = false } = Astro.props;
const { title, summary, date, tags, milestone, cover, coverAlt } = post.data;
const href = url(`${lang}/devlog/${postSlug(post)}/`);
---

<article class:list={["card", { featured }]} data-tags={tags.join(",")}>
  {cover && (
    <a href={href} class="cover" tabindex="-1" aria-hidden="true">
      <Image src={cover} alt={coverAlt ?? ""} widths={[480, 800, 1200]} sizes="(max-width: 720px) 100vw, 560px" loading="lazy" />
    </a>
  )}
  <div class="body">
    <div class="meta">
      {milestone && <span class="hex-badge" title={`${t(lang, "post.milestone")} ${milestone}`}>{milestone}</span>}
      <div>
        <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
        <span class="muted"> · {readingTime(post.body)} {t(lang, "post.readingTime")}</span>
      </div>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p class="muted">{summary}</p>
    <div class="tags">{tags.map((tag) => <span class="tag">#{tag}</span>)}</div>
  </div>
</article>

<style>
  .card {
    position: relative; display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s;
  }
  .card:hover { transform: translateY(-3px); border-color: var(--gold); box-shadow: var(--shadow); }
  .cover img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .body { padding: 1.2rem 1.3rem 1.3rem; display: flex; flex-direction: column; flex: 1; }
  .meta { display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; margin-bottom: 0.7rem; }
  time { color: var(--text); font-weight: 600; }
  h3 { font-size: 1.3rem; margin-bottom: 0.4em; }
  h3 a { color: var(--text); text-decoration: none; }
  /* toda la tarjeta clicable */
  h3 a::after { content: ""; position: absolute; inset: 0; }
  .body p { font-size: 0.97rem; flex: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .featured { display: grid; grid-template-columns: 1.15fr 1fr; }
  .featured .cover img { height: 100%; aspect-ratio: auto; min-height: 280px; }
  .featured h3 { font-size: 1.7rem; }
  @media (max-width: 760px) { .featured { display: flex; } .featured .cover img { min-height: 0; aspect-ratio: 16/9; } }
</style>
