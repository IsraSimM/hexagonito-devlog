---
/** Estado del lanzamiento. Se configura en src/data/launch.ts; lo que esté en null no se muestra. */
import { formatDate, t, type Lang } from "../i18n/ui";
import { launch } from "../data/launch";

interface Props { lang: Lang }
const { lang } = Astro.props;
const date = launch.releaseDate ? new Date(launch.releaseDate) : null;
---

<div class="launch" data-release={launch.releaseDate ?? ""}>
  <div class="status">
    <span class="pulse" aria-hidden="true"></span>
    <div>
      <strong>{date ? t(lang, "launch.release") : t(lang, "launch.soon")}</strong>
      <span class="muted">{date ? formatDate(date, lang) : t(lang, "launch.tba")} · {launch.platforms.join(", ")}</span>
    </div>
  </div>

  {date && (
    <div class="countdown" aria-live="polite" data-out={t(lang, "launch.out")}>
      <div><b data-k="d">–</b><small>{t(lang, "launch.days")}</small></div>
      <div><b data-k="h">–</b><small>{t(lang, "launch.hours")}</small></div>
      <div><b data-k="m">–</b><small>{t(lang, "launch.minutes")}</small></div>
    </div>
  )}

  {(launch.stores.steam || launch.stores.itch) && (
    <div class="stores">
      {launch.stores.steam && <a class="btn primary" href={launch.stores.steam} target="_blank" rel="noopener">{t(lang, "launch.steam")}</a>}
      {launch.stores.itch && <a class="btn" href={launch.stores.itch} target="_blank" rel="noopener">{t(lang, "launch.itch")}</a>}
    </div>
  )}

  {launch.trailerYouTubeId && (
    <div class="trailer">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${launch.trailerYouTubeId}`}
        title={`HexaGonito · ${t(lang, "launch.trailer")}`}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>(".launch[data-release]").forEach((box) => {
    const iso = box.dataset.release;
    const cd = box.querySelector<HTMLElement>(".countdown");
    if (!iso || !cd) return;
    const target = new Date(iso + "T00:00:00").getTime();
    const tick = () => {
      const ms = target - Date.now();
      if (ms <= 0) { cd.textContent = cd.dataset.out ?? ""; return; }
      const d = Math.floor(ms / 864e5), h = Math.floor((ms % 864e5) / 36e5), m = Math.floor((ms % 36e5) / 6e4);
      const set = (k: string, v: number) => { const el = cd.querySelector(`[data-k="${k}"]`); if (el) el.textContent = String(v); };
      set("d", d); set("h", h); set("m", m);
      setTimeout(tick, 30_000);
    };
    tick();
  });
</script>

<style>
  .launch {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem;
    padding: 1rem 1.2rem; border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--gold) 45%, var(--line));
    background: color-mix(in srgb, var(--gold) 7%, var(--surface));
  }
  .status { display: flex; align-items: center; gap: 0.8rem; }
  .status strong { display: block; font-family: var(--font-display); font-size: 1.1rem; color: var(--gold); }
  .status span { font-size: 0.9rem; }
  .pulse { width: 12px; height: 12px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 0 var(--gold); animation: pulse 2s infinite; flex: none; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .countdown { display: flex; gap: 0.5rem; }
  .countdown div { text-align: center; min-width: 3.4rem; padding: 0.3rem; border-radius: 8px; background: var(--surface-2); }
  .countdown b { display: block; font-family: var(--font-display); font-size: 1.4rem; color: var(--gold); }
  .countdown small { font-size: 0.7rem; color: var(--muted); }
  .stores { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-left: auto; }
  .trailer { width: 100%; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; }
  .trailer iframe { width: 100%; height: 100%; border: 0; }
</style>
