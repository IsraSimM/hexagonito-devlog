---
import Logo from "./Logo.astro";
import { t, url, type Lang } from "../i18n/ui";
import { studio } from "../data/launch";
interface Props { lang: Lang }
const { lang } = Astro.props;
const social = Object.entries(studio.social).filter(([, href]) => href) as [string, string][];
const socialLabel: Record<string, string> = { x: "X", youtube: "YouTube", discord: "Discord", bluesky: "Bluesky" };
---

<footer>
  <div class="container inner">
    <div class="studio">
      <Logo size={40} title={studio.name} />
      <div>
        <strong>{studio.name}</strong>
        <p class="muted">{t(lang, "footer.made")}</p>
      </div>
    </div>
    <nav aria-label="Footer">
      <a href={url(`${lang}/devlog/`)}>{t(lang, "nav.devlog")}</a>
      <a href={url(`${lang}/factions/`)}>{t(lang, "nav.factions")}</a>
      <a href={url(`${lang}/press/`)}>{t(lang, "nav.press")}</a>
      <a href={url(`${lang}/rss.xml`)}>{t(lang, "nav.rss")}</a>
      {social.map(([k, href]) => <a href={href} rel="me noopener" target="_blank">{socialLabel[k] ?? k}</a>)}
    </nav>
    <p class="copy muted">© {new Date().getFullYear()} {studio.name}</p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); margin-top: 5rem; background: var(--bg-2); }
  .inner { display: flex; align-items: center; gap: 1rem 2rem; padding-block: 1.8rem; flex-wrap: wrap; }
  .studio { display: flex; align-items: center; gap: 0.8rem; flex: 1; min-width: 240px; --logo-cut: var(--bg-2); }
  strong { font-family: var(--font-display); font-size: 1.05rem; }
  .studio p { margin: 0; font-size: 0.9rem; }
  nav { display: flex; gap: 1.1rem; flex-wrap: wrap; }
  nav a { font-family: var(--font-display); font-weight: 700; text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  .copy { width: 100%; margin: 0; font-size: 0.8rem; }
</style>
